{
  "schemaVersion": 1,
  "id": "radminlan",
  "version": "${version}",
  "name": "RadminLAN",
  "description": "Manage Radmin VPN networks and users from inside Minecraft. Install LanWorlds for optional LAN room integration.",
  "authors": [
    "flexfox0424"
  ],
  "contact": {
    "homepage": "https://github.com/block-fox/radminlan",
    "sources": "https://github.com/block-fox/radminlan",
    "issues": "https://github.com/block-fox/radminlan/issues"
  },
  "license": "MIT",
  "icon": "assets/radminlan/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.radminlan.RadminLanClient"
    ],
    "modmenu": [
      "dev.radminlan.compat.ModMenuEntrypoint"
    ]
  },
  "mixins": [
    "radminlan.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.19.5",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=25"
  },
  "suggests": {
    "modmenu": "*",
    "lanworlds": ">=0.1.0"
  }
}
