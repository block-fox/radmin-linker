{
  "schemaVersion": 1,
  "id": "radminlinker",
  "breaks": { "radminlan": "*" },
  "version": "${version}",
  "name": "Radmin Linker",
  "description": "Manage Radmin VPN networks and users from inside Minecraft. Install LanWorlds for optional LAN room integration.",
  "authors": [
    "flexfox0424"
  ],
  "contact": {
    "homepage": "https://github.com/block-fox/radmin-linker",
    "sources": "https://github.com/block-fox/radmin-linker",
    "issues": "https://github.com/block-fox/radmin-linker/issues"
  },
  "license": "MIT",
  "icon": "assets/radminlinker/icon.png",
  "environment": "client",
  "entrypoints": {
    "client": [
      "dev.radminlinker.RadminLinkerClient"
    ],
    "modmenu": [
      "dev.radminlinker.compat.ModMenuEntrypoint"
    ]
  },
  "mixins": [
    "radminlinker.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.18.1",
    "fabric-api": "*",
    "minecraft": "${minecraft_dependency}",
    "java": ">=21"
  },
  "suggests": {
    "modmenu": "*",
    "lanworlds": ">=0.1.0"
  }
}
